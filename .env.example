# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Deployed URL on Vercel (or ngrok/tunnel for local testing)
WEBAPP_URL=https://your-project.vercel.app

# Gemini AI API Key (FREE) - для распознавания скриншотов тренировок
# Получить бесплатно: https://aistudio.google.com/ -> Get API Key
# Без него распознавание работает через Tesseract.js (менее точно)
GEMINI_API_KEY=your_gemini_api_key_here
